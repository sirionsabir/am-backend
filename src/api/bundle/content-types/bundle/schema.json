{
  "kind": "collectionType",
  "collectionName": "bundles",
  "info": {
    "singularName": "bundle",
    "pluralName": "bundles",
    "displayName": "bundle"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "originalPrice": {
      "type": "decimal",
      "required": true
    },
    "bundlePrice": {
      "type": "decimal"
    },
    "displayOrder": {
      "type": "integer",
      "required": true
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "bundles"
    }
  }
}
